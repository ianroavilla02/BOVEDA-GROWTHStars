# G*S Environment Variables Template
# Copy this file to .env and fill with your credentials
# DO NOT commit .env to repo (already in .gitignore)

# === Supabase ===
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key_here
SUPABASE_DB_PASSWORD=your_db_password_here

# === Future ===
# ANTHROPIC_API_KEY=sk-ant-... (when migrating from Claude Pro to API)
# OPENAI_API_KEY=sk-... (if needed for embeddings)
